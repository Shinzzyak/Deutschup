# NOTE: tests/ and playwright.config.ts used to be listed here while being
# tracked at the same time. Git honours the tracked copies, so the entries did
# nothing except silently swallow every NEW file added under tests/ — a trap.
# They are tracked on purpose; do not re-add them. Test credentials belong in
# the environment (see docs/TESTING.md), never in a file.

# Test run artifacts — screenshots/traces of a signed-in session must never be
# committed. The report currently in playwright-report/ predates this rule.
tests/results/
tests/screenshots/
test-results/
playwright-report/
blob-report/
