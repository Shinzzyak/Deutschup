# Cache policy for the SPA build output.
# Vite emits content-hashed files into /assets, so they are safe to pin forever.
# NOTE: Vary: Accept-Encoding added to stop gzip/brotli cache mismatch; CF Pages
# may ignore Vary, so keep max-age short-ish for JS to avoid corrupt-cache locks.
/assets/*.js
  Cache-Control: public, max-age=86400, must-revalidate
  Vary: Accept-Encoding

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

# The SPA shell must never be cached, or a deploy keeps serving stale chunk refs.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
